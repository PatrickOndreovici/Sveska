# Copy to .env and adjust if needed. Compose and the Makefile both read .env.
POSTGRES_USER=lsp
POSTGRES_PASSWORD=lsp_dev_password
POSTGRES_DB=lsp
POSTGRES_PORT=5433

# Used by the Go API when run on the host.
DATABASE_URL=postgres://lsp:lsp_dev_password@localhost:5433/lsp?sslmode=disable
HTTP_ADDR=:8080
