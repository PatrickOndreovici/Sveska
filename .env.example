# Copy to .env and adjust if needed. Compose and the Makefile both read .env.
POSTGRES_USER=lsp
POSTGRES_PASSWORD=lsp_dev_password
POSTGRES_DB=lsp
POSTGRES_PORT=5433
# Separate database for integration tests; truncated by every test.
POSTGRES_TEST_DB=lsp_test

# Used by the Go API when run on the host.
DATABASE_URL=postgres://lsp:lsp_dev_password@localhost:5433/lsp?sslmode=disable
HTTP_ADDR=:8080
# The browser origin allowed to send state-changing requests (CSRF check).
APP_ORIGIN=http://localhost:5180
# Session cookies require HTTPS unless this is false. Local development only.
COOKIE_SECURE=false

# Used by `make test-integration`.
TEST_DATABASE_URL=postgres://lsp:lsp_dev_password@localhost:5433/lsp_test?sslmode=disable
